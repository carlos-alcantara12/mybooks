# Copie para .env e substitua todos os valores de exemplo antes de publicar.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-at-least-50-characters-long
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com

DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=mybooks
DJANGO_DB_USER=mybooks_app
DJANGO_DB_PASSWORD=replace-with-the-database-password
DJANGO_DB_HOST=postgres.example.internal
DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_DB_SSLMODE=require

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
# Ative HSTS depois de confirmar que todo o domínio funciona em HTTPS.
DJANGO_SECURE_HSTS_SECONDS=0
# Ative somente se o proxy confiável remover headers encaminhados enviados pelo cliente.
DJANGO_TRUST_X_FORWARDED_PROTO=false
